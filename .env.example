# Скопируйте в .env в корне репозитория: cp .env.example .env
# Файл .env не коммитится в git.

# JWT (один и тот же секрет для users и controller, минимум 32 символа)
# Минимум 32 символа (UTF-8), одинаковый для users и controller
JWT_SECRET=change_me_at_least_32_characters_long_secret
JWT_LIFETIME_MINUTES=1440

# PostgreSQL (локально и docker-compose.dev)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ЮKassa (тестовый магазин — ключи из личного кабинета ЮKassa)
YOOKASSA_SHOP_ID=1343396
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:5174/payment/return
